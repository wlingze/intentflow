{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wlingze/intentflow/schema/review-result.schema.json",
  "title": "intentflow review result",
  "description": "The single JSON document written by `intentflow review --json` to stdout. Only actionable comments are included; resolved comments and quote snippets stay in the human Markdown.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "reason",
    "verdict",
    "summary",
    "comments",
    "revision"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": ["submitted", "cancelled", "timeout", "error"]
    },
    "reason": {
      "enum": [
        null,
        "user",
        "page-closed",
        "interrupted",
        "timeout",
        "usage",
        "git",
        "patch",
        "pr",
        "listen",
        "internal"
      ]
    },
    "verdict": {
      "enum": [null, "approve", "request-changes", "comment"]
    },
    "summary": {
      "type": ["string", "null"]
    },
    "comments": {
      "type": "array",
      "items": { "$ref": "#/$defs/comment" }
    },
    "revision": {
      "oneOf": [
        { "$ref": "#/$defs/revision" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "submitted" } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "reason": { "type": "null" },
          "verdict": { "enum": ["approve", "request-changes", "comment"] },
          "summary": { "type": "string" },
          "revision": { "$ref": "#/$defs/revision" }
        }
      }
    },
    {
      "if": {
        "properties": { "status": { "enum": ["cancelled", "timeout", "error"] } },
        "required": ["status"]
      },
      "then": {
        "properties": {
          "reason": { "type": "string" },
          "verdict": { "type": "null" },
          "summary": { "type": "null" },
          "comments": { "maxItems": 0 }
        }
      }
    }
  ],
  "$defs": {
    "comment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file", "line", "end_line", "side", "body"],
      "properties": {
        "file": { "type": ["string", "null"] },
        "line": { "type": ["integer", "null"], "minimum": 1 },
        "end_line": { "type": ["integer", "null"], "minimum": 1 },
        "side": { "enum": [null, "before", "after"] },
        "body": { "type": "string", "minLength": 1 }
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "base", "head"],
      "properties": {
        "id": { "type": "string" },
        "base": { "type": "string" },
        "head": { "type": "string" }
      }
    }
  }
}
